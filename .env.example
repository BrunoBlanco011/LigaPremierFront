# Copia este archivo a .env.local y completa los valores.

# URL del backend FastAPI (sin /api/v1; el cliente lo agrega). En producción debe ser https://
VITE_API_URL=http://localhost:8000

# Supabase: solo maneja la sesión (el login pasa por la API). Solo la llave publicable, nunca la service_role
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
