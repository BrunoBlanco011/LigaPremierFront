# Copia este archivo a .env.local y completa los valores.

# URL del backend FastAPI (sin /api/v1; el cliente lo agrega)
VITE_API_URL=http://localhost:8000

# Supabase (para el login — RF-01)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Actualización en tiempo real por WebSocket. Déjalo en false mientras el backend
# no exponga el endpoint /api/v1/ws; ponlo en true cuando ya exista.
VITE_ENABLE_REALTIME=false
